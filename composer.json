{
    "name": "alexitdev91/laravel-telegram-bot",
    "type": "library",
    "description": "Laravel-friendly PHP SDK for the official Telegram Bot API.",
    "keywords": ["telegram", "telegram-bot", "laravel", "notifications"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/prompts": "^0.3.0",
        "psr/log": "^3.0",
        "ext-openssl": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "AlexItDev91\\LaravelTelegramBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexItDev91\\LaravelTelegramBot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "check:telegram-api-surface": "php scripts/check-telegram-api-surface.php",
        "check:release-readiness": "php scripts/check-release-readiness.php",
        "generate:github-release-notes": "php scripts/generate-github-release-notes.php",
        "generate:telegram-api-schema": "php scripts/generate-telegram-api-schema.php",
        "test": "vendor/bin/phpunit",
        "test:coverage-surface": "vendor/bin/phpunit --filter=TelegramBotApiSurfaceTest",
        "verify:packagist-release": "php scripts/verify-packagist-release.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexItDev91\\LaravelTelegramBot\\Laravel\\TelegramBotServiceProvider"
            ],
            "aliases": {
                "TelegramBot": "AlexItDev91\\LaravelTelegramBot\\Facades\\TelegramBot"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
